# Enable Powerlevel10k instant prompt. Keep this near the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
CASE_SENSITIVE="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"

plugins=(git zsh-syntax-highlighting zsh-autosuggestions)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

[[ ! -f "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"

alias enw="emacsclient -nw"
if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - --no-rehash zsh)"
fi

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
  [[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init - zsh)"
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

if command -v /usr/libexec/java_home >/dev/null 2>&1; then
  JAVA_HOME_VALUE="$(/usr/libexec/java_home 2>/dev/null || true)"
  if [[ -n "$JAVA_HOME_VALUE" ]]; then
    export JAVA_HOME="$JAVA_HOME_VALUE"
    export PATH="$JAVA_HOME/bin:$PATH"
  fi
  unset JAVA_HOME_VALUE
fi

if [[ -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export PATH="$ANDROID_HOME/platform-tools:$PATH"
fi

[[ -d "$HOME/opensource/flutter/bin" ]] && export PATH="$HOME/opensource/flutter/bin:$PATH"
[[ -d "$HOME/opensource/depot_tools" ]] && export PATH="$HOME/opensource/depot_tools:$PATH"

[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

